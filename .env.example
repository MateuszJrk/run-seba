NEXT_PUBLIC_SITE_URL=https://run-seba.pl

# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-05-08
SANITY_API_READ_TOKEN=
SANITY_REVALIDATE_SECRET=

# LightWidget (Instagram embed) — widget ID z lightwidget.com
NEXT_PUBLIC_LIGHTWIDGET_ID=

# Strava API (po OAuth Seby)
# 1. Zarejestruj aplikację: https://www.strava.com/settings/api
# 2. Po OAuth: https://www.strava.com/oauth/authorize?client_id=XXX&redirect_uri=...&response_type=code&scope=read,activity:read
# 3. Wymień authorization code na refresh_token (raz)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# MapTiler (vector tiles dla /biegi/[id]) — free 100k req/m
# https://cloud.maptiler.com/account/keys/
# Bez tego klucza mapy używają OSM raster tiles (działają, ale brzydsze)
NEXT_PUBLIC_MAPTILER_KEY=

# Google Analytics 4 — Measurement ID (G-XXXXXXXXXX)
# https://analytics.google.com/ → Admin → Property Settings
# GDPR: używamy Consent Mode default-deny — bez bannera, agregaty anonimowe
NEXT_PUBLIC_GA_MEASUREMENT_ID=
